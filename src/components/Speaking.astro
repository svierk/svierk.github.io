---
import TalkCard from './TalkCard.astro';
import WorldMap from './WorldMap.astro';
import { talks } from '../data/talks';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { buildSpeakingMap, isUpcoming, speakingStats } from '../lib/speaking';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** How many events are visible before "show more" is pressed. */
const PAGE_SIZE = 5;

// The upcoming/past split is evaluated at build time; the weekly scheduled
// rebuild keeps it (and the article list) fresh without manual updates.
const today = new Date().toISOString().slice(0, 10);
const sortedTalks = [...talks].sort((a, b) => b.date.localeCompare(a.date));
const upcomingIds = new Set(sortedTalks.filter((talk) => isUpcoming(talk, today)).map((talk) => talk.id));
const { markers, view } = buildSpeakingMap(talks, today);
const stats = speakingStats(talks);

const filters = [
  { key: 'all', label: t('speaking.filterAll') },
  ...(upcomingIds.size > 0 ? [{ key: 'upcoming', label: t('speaking.upcoming') }] : []),
  ...stats.years.map((year) => ({ key: `year:${year}`, label: String(year) })),
];

const hiddenCount = Math.max(sortedTalks.length - PAGE_SIZE, 0);
---

<div data-speaking>
  <dl class="stats">
    <div class="stat">
      <dt>{t('speaking.statEvents')}</dt>
      <dd>{stats.events}</dd>
    </div>
    <div class="stat">
      <dt>{t('speaking.statCountries')}</dt>
      <dd>{stats.countries}</dd>
    </div>
    <div class="stat">
      <dt>{t('speaking.statSessions')}</dt>
      <dd>{stats.sessions}</dd>
    </div>
  </dl>

  <WorldMap {markers} {view} {lang} />

  <div class="filters" role="group" aria-label={t('speaking.filterLabel')}>
    {
      filters.map((filter) => (
        <button type="button" class="filter-chip" data-filter={filter.key} aria-pressed={filter.key === 'all'}>
          {filter.label}
        </button>
      ))
    }
    <button type="button" class="filter-chip place-chip" hidden>
      <span class="place-label"></span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
      <span class="sr-only">{t('speaking.clearFilter')}</span>
    </button>
  </div>

  <ol class="timeline">
    {
      sortedTalks.map((talk, index) => (
        <li
          class:list={{ upcoming: upcomingIds.has(talk.id) }}
          data-upcoming={String(upcomingIds.has(talk.id))}
          data-year={talk.date.slice(0, 4)}
          data-place={talk.place}
          hidden={index >= PAGE_SIZE}
        >
          <TalkCard {talk} {lang} upcoming={upcomingIds.has(talk.id)} />
        </li>
      ))
    }
  </ol>

  <div class="pager">
    <button type="button" class="pager-button" data-label={t('speaking.showMore')} hidden={hiddenCount === 0}>
      <span class="pager-label">{`${t('speaking.showMore')} (${hiddenCount})`}</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </button>
  </div>

  <p class="muted meetups">{t('speaking.meetups')}</p>

  <noscript>
    <style is:inline>
      /* Without JS the filters and the pager do nothing, so show every event. */
      .timeline > li[hidden] {
        display: block !important;
      }

      .filters,
      .pager {
        display: none !important;
      }
    </style>
  </noscript>
</div>

<script>
  const PAGE_SIZE = 5;
  const section = document.querySelector<HTMLElement>('[data-speaking]');

  if (section) {
    const list = section.querySelector<HTMLOListElement>('.timeline')!;
    // `:scope >` matters - the talk cards carry their own <li> session lists.
    const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')];
    const chips = [...section.querySelectorAll<HTMLButtonElement>('.filter-chip')];
    const placeChip = section.querySelector<HTMLButtonElement>('.place-chip')!;
    const placeLabel = placeChip.querySelector<HTMLSpanElement>('.place-label')!;
    const markers = [...section.querySelectorAll<HTMLButtonElement>('.marker')];
    const pager = section.querySelector<HTMLButtonElement>('.pager-button')!;
    const pagerLabel = pager.querySelector<HTMLSpanElement>('.pager-label')!;

    /** 'all' | 'upcoming' | 'year:<yyyy>' | 'place:<id>' */
    let filter = 'all';
    let visible = PAGE_SIZE;

    const matches = (item: HTMLLIElement) => {
      if (filter === 'all') return true;
      if (filter === 'upcoming') return item.dataset.upcoming === 'true';
      const [kind, value] = filter.split(':');
      return kind === 'year' ? item.dataset.year === value : item.dataset.place === value;
    };

    /**
     * A year or upcoming filter thins out the map too; a city filter leaves
     * every marker in place so the next city stays one click away.
     */
    const markerMatches = (marker: HTMLButtonElement) => {
      if (filter === 'all' || filter.startsWith('place:')) return true;
      if (filter === 'upcoming') return marker.dataset.upcoming === 'true';
      return marker.dataset.years!.split(' ').includes(filter.split(':')[1]);
    };

    const render = () => {
      let matched = 0;
      for (const item of items) {
        const isMatch = matches(item);
        if (isMatch) matched += 1;
        item.hidden = !(isMatch && matched <= visible);
      }

      const remaining = matched - Math.min(visible, matched);
      pager.hidden = remaining === 0;
      pagerLabel.textContent = `${pager.dataset.label} (${remaining})`;

      placeChip.hidden = !filter.startsWith('place:');
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));

      for (const marker of markers) {
        marker.setAttribute('aria-pressed', String(`place:${marker.dataset.place}` === filter));
        const muted = !markerMatches(marker);
        marker.classList.toggle('is-muted', muted);
        marker.tabIndex = muted ? -1 : 0;
        marker.setAttribute('aria-hidden', String(muted));
      }
    };

    /** Lights up the marker belonging to the event card under the cursor. */
    const highlight = (place: string | null) => {
      for (const marker of markers) {
        marker.classList.toggle('is-highlighted', place !== null && marker.dataset.place === place);
      }
    };

    const setFilter = (next: string) => {
      filter = next;
      visible = PAGE_SIZE;
      render();
    };

    for (const chip of chips) {
      if (chip === placeChip) continue;
      chip.addEventListener('click', () => setFilter(chip.dataset.filter!));
    }

    placeChip.addEventListener('click', () => setFilter('all'));

    for (const marker of markers) {
      marker.addEventListener('click', () => {
        const key = `place:${marker.dataset.place}`;
        if (filter === key) {
          setFilter('all');
          return;
        }
        placeChip.dataset.filter = key;
        placeLabel.textContent = `${marker.dataset.flag} ${marker.dataset.city}`;
        setFilter(key);
        // On narrow screens the map fills the viewport - bring the result into view.
        if (list.getBoundingClientRect().top > window.innerHeight * 0.75) {
          list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    for (const item of items) {
      const place = item.dataset.place ?? null;
      item.addEventListener('mouseenter', () => highlight(place));
      item.addEventListener('mouseleave', () => highlight(null));
      // Covers keyboard users tabbing through the links inside a card.
      item.addEventListener('focusin', () => highlight(place));
      item.addEventListener('focusout', () => highlight(null));
    }

    pager.addEventListener('click', () => {
      const firstNew = items.filter((item) => matches(item))[visible];
      visible += PAGE_SIZE;
      render();
      // Keep the keyboard focus somewhere sensible once the button disappears.
      if (pager.hidden) firstNew?.querySelector('a')?.focus();
    });

    render();
  }
</script>

<style>
  .stats {
    display: grid;
    /* minmax(0, …) - otherwise a long label stretches the track past the page. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 1.75rem;
  }

  .stat {
    /* Term first in the DOM (label, then value), value first on screen. */
    display: flex;
    flex-direction: column-reverse;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
    background: var(--bg-card);
  }

  .stat dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.85rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  /* `hidden` has to beat the display declarations above. */
  .filter-chip[hidden],
  .pager-button[hidden] {
    display: none;
  }

  .filter-chip:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .filter-chip[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .timeline {
    list-style: none;
    position: relative;
    margin: 0;
    padding: 0 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* Vertical gradient line connecting the events. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2) 60%, transparent);
    opacity: 0.4;
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li[hidden] {
    display: none;
  }

  /* Glowing dot per event. */
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -1.98rem;
    top: 1.55rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .timeline > li.upcoming::before {
    background: var(--accent);
    box-shadow:
      0 0 0 4px var(--accent-soft),
      0 0 14px var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 4px var(--accent-soft),
        0 0 10px var(--accent);
    }
    50% {
      box-shadow:
        0 0 0 7px var(--accent-soft),
        0 0 20px var(--accent);
    }
  }

  .pager {
    margin-top: 1.25rem;
    padding-left: 2rem;
  }

  .pager-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 0.65rem 1rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .pager-button:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    background: var(--accent-soft);
  }

  .meetups {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }

  @media (max-width: 720px) {
    .stats {
      gap: 0.6rem;
    }

    .stat {
      padding: 0.7rem 0.8rem;
    }

    .stat dd {
      font-size: 1.5rem;
    }

    .stat dt {
      font-size: 0.68rem;
      letter-spacing: 0.05em;
    }

    .timeline {
      padding-left: 1.4rem;
    }

    .timeline > li::before {
      left: -1.4rem;
    }

    .pager {
      padding-left: 1.4rem;
    }
  }
</style>
