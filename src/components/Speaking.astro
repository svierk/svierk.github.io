---
import Globe from './Globe.astro';
import TalkCard from './TalkCard.astro';
import { talks } from '../data/talks';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { buildGlobeCities, isUpcoming, speakingStats } from '../lib/speaking';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** How many events are visible before "show more" is pressed. */
const PAGE_SIZE = 4;

// The upcoming/past split is evaluated at build time; the weekly scheduled
// rebuild keeps it (and the article list) fresh without manual updates.
const today = new Date().toISOString().slice(0, 10);
const sortedTalks = [...talks].sort((a, b) => b.date.localeCompare(a.date));
const upcomingIds = new Set(sortedTalks.filter((talk) => isUpcoming(talk, today)).map((talk) => talk.id));
const cities = buildGlobeCities(talks, today);
const stats = speakingStats(talks);

const filters = [
  { key: 'all', label: t('speaking.filterAll') },
  ...(upcomingIds.size > 0 ? [{ key: 'upcoming', label: t('speaking.upcoming') }] : []),
  ...stats.years.map((year) => ({ key: `year:${year}`, label: String(year) })),
];

const hiddenCount = Math.max(sortedTalks.length - PAGE_SIZE, 0);
---

<div class="speaking" data-speaking data-page-size={PAGE_SIZE}>
  <div class="globe-col">
    <dl class="stats">
      <div class="stat">
        <dt>{t('speaking.statEvents')}</dt>
        <dd>{stats.events}</dd>
      </div>
      <div class="stat">
        <dt>{t('speaking.statCountries')}</dt>
        <dd>{stats.countries}</dd>
      </div>
      <div class="stat">
        <dt>{t('speaking.statSessions')}</dt>
        <dd>{stats.sessions}</dd>
      </div>
    </dl>

    <Globe {cities} {lang} />

    <div class="filters" role="group" aria-label={t('speaking.filterLabel')}>
      {
        filters.map((filter) => (
          <button type="button" class="filter-chip" data-filter={filter.key} aria-pressed={filter.key === 'all'}>
            {filter.label}
          </button>
        ))
      }
      <button type="button" class="filter-chip place-chip" hidden>
        <span class="place-label"></span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
        <span class="sr-only">{t('speaking.clearFilter')}</span>
      </button>
    </div>
  </div>

  <div class="list-col">
    <ol class="timeline">
      {
        sortedTalks.map((talk, index) => (
          <li
            class:list={{ upcoming: upcomingIds.has(talk.id) }}
            data-upcoming={String(upcomingIds.has(talk.id))}
            data-year={talk.date.slice(0, 4)}
            data-place={talk.place}
            hidden={index >= PAGE_SIZE}
          >
            <TalkCard {talk} {lang} upcoming={upcomingIds.has(talk.id)} />
          </li>
        ))
      }
    </ol>

    <div class="pager">
      <button type="button" class="pager-button" data-label={t('common.showMore')} hidden={hiddenCount === 0}>
        <span class="pager-label">{`${t('common.showMore')} (${hiddenCount})`}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>
    </div>

    <p class="meetups muted">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
      </svg>
      <span>{t('speaking.meetups')}</span>
    </p>
  </div>
</div>

<noscript>
  <style is:inline>
    /* Without JS the filters and the pager do nothing, so show every event. */
    .timeline > li[hidden] {
      display: block !important;
    }

    .filters,
    .pager {
      display: none !important;
    }
  </style>
</noscript>

<script>
  type GlobeElement = HTMLElement & {
    update(visibleIds: string[] | null, selectedId: string | null): void;
    highlight(id: string | null): void;
  };

  const section = document.querySelector<HTMLElement>('[data-speaking]');

  if (section) {
    // Kept in sync with the server-rendered initial state via the markup.
    const PAGE_SIZE = Number(section.dataset.pageSize) || 4;
    const list = section.querySelector<HTMLOListElement>('.timeline')!;
    // `:scope >` matters - the talk cards carry their own <li> session lists.
    const items = [...list.querySelectorAll<HTMLLIElement>(':scope > li')];
    const chips = [...section.querySelectorAll<HTMLButtonElement>('.filter-chip')];
    const placeChip = section.querySelector<HTMLButtonElement>('.place-chip')!;
    const placeLabel = placeChip.querySelector<HTMLSpanElement>('.place-label')!;
    const pager = section.querySelector<HTMLButtonElement>('.pager-button')!;
    const pagerLabel = pager.querySelector<HTMLSpanElement>('.pager-label')!;
    const globe = section.querySelector<GlobeElement>('speaking-globe');

    /** 'all' | 'upcoming' | 'year:<yyyy>' | 'place:<id>' */
    let filter = 'all';
    let visible = PAGE_SIZE;

    const matches = (item: HTMLLIElement) => {
      if (filter === 'all') return true;
      if (filter === 'upcoming') return item.dataset.upcoming === 'true';
      const [kind, value] = filter.split(':');
      return kind === 'year' ? item.dataset.year === value : item.dataset.place === value;
    };

    /**
     * A year or upcoming filter thins out the globe too; a city filter leaves
     * every marker in place so the next city stays one click away.
     */
    const globeState = (): [string[] | null, string | null] => {
      if (filter.startsWith('place:')) return [null, filter.split(':')[1]];
      if (filter === 'all') return [null, null];
      const ids = new Set(items.filter((item) => matches(item)).map((item) => item.dataset.place!));
      return [[...ids], null];
    };

    const render = () => {
      let matched = 0;
      for (const item of items) {
        const isMatch = matches(item);
        if (isMatch) matched += 1;
        item.hidden = !(isMatch && matched <= visible);
      }

      const remaining = matched - Math.min(visible, matched);
      pager.hidden = remaining === 0;
      pagerLabel.textContent = `${pager.dataset.label} (${remaining})`;

      placeChip.hidden = !filter.startsWith('place:');
      for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));

      globe?.update?.(...globeState());
    };

    const setFilter = (next: string) => {
      filter = next;
      visible = PAGE_SIZE;
      render();
    };

    for (const chip of chips) {
      if (chip === placeChip) continue;
      chip.addEventListener('click', () => setFilter(chip.dataset.filter!));
    }

    placeChip.addEventListener('click', () => setFilter('all'));

    // Raised by the globe when one of its markers is activated.
    globe?.addEventListener('place-select', (event) => {
      const id = (event as CustomEvent<string>).detail;
      const key = `place:${id}`;
      if (filter === key) {
        setFilter('all');
        return;
      }
      placeChip.dataset.filter = key;
      const marker = globe.querySelector<HTMLElement>(`.marker[data-place="${id}"]`);
      placeLabel.textContent = `${marker?.dataset.flag ?? ''} ${marker?.dataset.city ?? ''}`.trim();
      setFilter(key);
      // On narrow screens the globe fills the viewport - bring the result into view.
      if (list.getBoundingClientRect().top > window.innerHeight * 0.75) {
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    for (const item of items) {
      const place = item.dataset.place ?? null;
      item.addEventListener('mouseenter', () => globe?.highlight?.(place));
      item.addEventListener('mouseleave', () => globe?.highlight?.(null));
      // Covers keyboard users tabbing through the links inside a card.
      item.addEventListener('focusin', () => globe?.highlight?.(place));
      item.addEventListener('focusout', () => globe?.highlight?.(null));
    }

    pager.addEventListener('click', () => {
      const firstNew = items.filter((item) => matches(item))[visible];
      visible += PAGE_SIZE;
      render();
      // Keep the keyboard focus somewhere sensible once the button disappears.
      if (pager.hidden) firstNew?.querySelector('a')?.focus();
    });

    render();
    // The globe upgrades from its own module - hand it the state once it exists.
    customElements.whenDefined('speaking-globe').then(() => globe?.update?.(...globeState()));
  }
</script>

<style>
  .speaking {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2.25rem;
    align-items: start;
  }

  .globe-col {
    position: sticky;
    /* Clears the sticky header. */
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .stats {
    display: grid;
    /* minmax(0, …) - otherwise a long label stretches the track past the page. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
  }

  .stat {
    /* Term first in the DOM (label, then value), value first on screen. */
    display: flex;
    flex-direction: column-reverse;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.7rem 0.85rem;
    background: var(--bg-card);
  }

  .stat dd {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    /* Centred under the globe, in line with the counters and the hint above. */
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.85rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  /* `hidden` has to beat the display declaration above. */
  .filter-chip[hidden] {
    display: none;
  }

  .filter-chip:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .filter-chip[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .timeline {
    list-style: none;
    position: relative;
    margin: 0;
    padding: 0 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Vertical gradient line connecting the events. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2) 60%, transparent);
    opacity: 0.4;
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li[hidden] {
    display: none;
  }

  /* Glowing dot per event. */
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -1.48rem;
    top: 1.55rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .timeline > li.upcoming::before {
    background: var(--accent);
    box-shadow:
      0 0 0 4px var(--accent-soft),
      0 0 14px var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 4px var(--accent-soft),
        0 0 10px var(--accent);
    }
    50% {
      box-shadow:
        0 0 0 7px var(--accent-soft),
        0 0 20px var(--accent);
    }
  }

  .pager {
    margin-top: 1.1rem;
    padding-left: 1.5rem;
  }

  .meetups {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.9rem 0 0;
    padding-left: 1.5rem;
    font-size: 0.85rem;
  }

  .meetups svg {
    flex: none;
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .speaking {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .globe-col {
      position: static;
      /* Keeps the globe from dominating the page on a tablet. */
      max-width: 26rem;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .stat {
      padding: 0.6rem 0.7rem;
    }

    .stat dd {
      font-size: 1.45rem;
    }

    .stat dt {
      font-size: 0.66rem;
      letter-spacing: 0.05em;
    }

    .timeline {
      padding-left: 1.4rem;
    }

    .timeline > li::before {
      left: -1.4rem;
    }

    .pager,
    .meetups {
      padding-left: 1.4rem;
    }
  }
</style>
