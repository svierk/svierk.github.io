---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { formatRelative, useTranslations } from '../i18n/utils';
import type { RepoMeta } from '../lib/github';

interface Props {
  project: Project;
  lang: Lang;
  /** Live figures from the GitHub API; absent when the request failed. */
  meta?: RepoMeta;
}

const { project, lang, meta } = Astro.props;
const t = useTranslations(lang);
const url = `https://github.com/svierk/${project.repo}`;

const stars = meta?.stars ?? project.stars;
const pushed = meta?.pushedAt ? new Date(meta.pushedAt) : undefined;

/** GitHub's own colours, so the dot reads the same as it does on the repo page. */
const languageColors: Record<string, string> = {
  JavaScript: '#f1e05a',
  TypeScript: '#3178c6',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Apex: '#1797c0',
  Java: '#b07219',
  Shell: '#89e051',
  Python: '#3572a5',
};
---

<article class="card project">
  <div class="head">
    <h3>
      <a href={url} target="_blank" rel="noopener noreferrer">{project.repo}</a>
    </h3>
    <span class="stars muted" title={`${stars} ${t('opensource.stars')}`}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27Z" />
      </svg>
      {stars}
    </span>
  </div>
  <p class="description">{project.description[lang]}</p>
  <ul class="topics">
    {project.topics.map((topic) => <li class="chip">{topic}</li>)}
  </ul>
  {
    meta && (
      <p class="muted repo-meta">
        {meta.language && (
          <span class="lang">
            <span class="dot" style={`--lang:${languageColors[meta.language] ?? 'var(--text-muted)'}`} aria-hidden="true" />
            {meta.language}
          </span>
        )}
        {meta.forks > 0 && (
          <span class="forks">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="5" r="2.5" />
              <circle cx="18" cy="5" r="2.5" />
              <circle cx="12" cy="19" r="2.5" />
              <path d="M6 7.5v2a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-2M12 11.5v5" />
            </svg>
            {meta.forks} <span class="sr-only">{t('opensource.forks')}</span>
          </span>
        )}
        {pushed && (
          <span class="pushed">
            {t('opensource.updated')} <time datetime={pushed.toISOString()}>{formatRelative(pushed, lang)}</time>
          </span>
        )}
      </p>
    )
  }
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    font-size: 1.05rem;
    margin: 0;
    word-break: break-word;
  }

  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .description {
    margin: 0;
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
    padding: 0;
  }

  /* Live figures from the API - absent entirely when the request failed. */
  .repo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0.55rem 0 0;
    padding-top: 0.55rem;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
  }

  .lang,
  .forks {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--lang);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
