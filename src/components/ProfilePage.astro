---
import ArticleList from './ArticleList.astro';
import FeaturedCard from './FeaturedCard.astro';
import Footer from './Footer.astro';
import Hero from './Hero.astro';
import Nav from './Nav.astro';
import ProjectCard from './ProjectCard.astro';
import Section from './Section.astro';
import Speaking from './Speaking.astro';
import VideoCard from './VideoCard.astro';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { features } from '../data/featured';
import { githubProfileUrl, projects } from '../data/projects';
import { liveSessions } from '../data/sessions';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { fetchStarCounts } from '../lib/github';
import { fetchMediumArticles } from '../lib/medium';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const articles = await fetchMediumArticles(profile.mediumFeed);
const starCounts = await fetchStarCounts(projects.map((project) => project.repo));
---

<Base {lang}>
  <Nav {lang} />
  <main>
    <Hero {lang} />

    <Section id="about" title={t('about.title')}>
      <p class="about-body">{t('about.body')}</p>
    </Section>

    <Section id="speaking" title={t('speaking.title')} subtitle={t('speaking.subtitle')}>
      <Speaking {lang} />
    </Section>

    <Section id="sessions" title={t('sessions.title')} subtitle={t('sessions.subtitle')}>
      <div class="grid-2">
        {liveSessions.map((session) => <VideoCard {session} {lang} />)}
      </div>
    </Section>

    <Section id="featured" title={t('featured.title')} subtitle={t('featured.subtitle')}>
      <div class="grid-2">
        {features.map((feature) => <FeaturedCard {feature} {lang} />)}
      </div>
    </Section>

    <Section id="blog" title={t('blog.title')} subtitle={t('blog.subtitle')}>
      <ArticleList {articles} {lang} mediumUrl="https://medium.com/@svierk" />
    </Section>

    <Section id="opensource" title={t('opensource.title')} subtitle={t('opensource.subtitle')}>
      <div class="grid-2">
        {projects.map((project) => <ProjectCard {project} {lang} stars={starCounts[project.repo]} />)}
      </div>
      <p class="view-all">
        <a href={githubProfileUrl} target="_blank" rel="noopener noreferrer">{t('opensource.viewAll')} →</a>
      </p>
    </Section>
  </main>
  <Footer {lang} />
</Base>

<style>
  .about-body {
    max-width: 46rem;
    margin: 0;
  }

  .view-all {
    margin-top: 1.25rem;
  }
</style>
