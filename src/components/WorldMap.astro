---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { MapMarker, MapView } from '../lib/speaking';

interface Props {
  markers: MapMarker[];
  view: MapView;
  lang: Lang;
}

const { markers, view, lang } = Astro.props;
const t = useTranslations(lang);

/** Thin connectors for markers that had to move away from their real city. */
const leaders = markers
  .map((marker) => marker.leader)
  .filter((leader) => leader !== undefined)
  .map((leader) => `M${leader.x1.toFixed(1)} ${leader.y1.toFixed(1)}L${leader.x2.toFixed(1)} ${leader.y2.toFixed(1)}`)
  .join('');

/** Strokes are in viewBox units, so they have to follow the crop's zoom. */
const unitsPerPixel = view.width / 950;
---

<figure class="world-map">
  <div class="canvas">
    <div class="plot" style={`aspect-ratio:${view.width} / ${view.height}`}>
      <svg viewBox={view.viewBox} preserveAspectRatio="none" role="img" aria-label={t('speaking.mapLabel')}>
        <path
          class="land"
          d={view.landPath}
          fill="none"
          stroke="currentColor"
          stroke-width={view.dotRadius * 2}
          stroke-linecap="round"
        />
        {leaders && <path class="leaders" d={leaders} fill="none" stroke-width={(1.2 * unitsPerPixel).toFixed(2)} />}
      </svg>
      {
        markers.map((marker) => (
          <button
            type="button"
            class:list={['marker', `align-${marker.align}`, { upcoming: marker.upcoming }]}
            style={`--left:${marker.left.toFixed(3)}%;--top:${marker.top.toFixed(3)}%;--size:${marker.size.toFixed(3)}%`}
            data-place={marker.id}
            data-city={marker.city}
            data-flag={marker.flag}
            data-years={marker.years.join(' ')}
            data-upcoming={String(marker.upcoming)}
            aria-pressed="false"
          >
            <span class="pin" aria-hidden="true" />
            <span class="tip">
              <span class="tip-city">
                <span class="tip-flag" aria-hidden="true">
                  {marker.flag}
                </span>
                {marker.city}
              </span>
              {marker.events.map((event) => (
                <span class="tip-event">
                  {event.event}
                  <span class="tip-year">{event.date.slice(0, 4)}</span>
                </span>
              ))}
            </span>
          </button>
        ))
      }
    </div>
  </div>
  <figcaption class="muted">{t('speaking.mapHint')}</figcaption>
</figure>

<style>
  .world-map {
    margin: 0 0 1.75rem;
  }

  .canvas {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.1rem;
    background:
      radial-gradient(70% 110% at 50% 0%, var(--accent-soft), transparent 70%),
      var(--bg-card);
  }

  /* Markers are positioned in percent of this box, which the SVG fills exactly. */
  .plot {
    position: relative;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    /* The land dots pick this up through `stroke="currentColor"`. */
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
  }

  /* The dots need a touch more weight against a light background. */
  :global([data-theme='light']) svg {
    color: color-mix(in srgb, var(--text-muted) 58%, transparent);
  }

  .leaders {
    stroke: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  /* --- Markers: HTML on top of the SVG, so they stay keyboard accessible --- */

  .marker {
    position: absolute;
    left: var(--left);
    top: var(--top);
    /* Percentage size keeps the markers in step with the map at every width;
       the floor keeps them visible once the map shrinks on phones. */
    width: max(8px, var(--size));
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    transform: translate(-50%, -50%);
    cursor: pointer;
    outline-offset: 5px;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  /* Filtered out by the year chips - kept in the DOM so it can fade back in. */
  .marker.is-muted {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.4);
    pointer-events: none;
  }

  /* Keeps small markers comfortably tappable without growing the dot. */
  .marker::before {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
  }

  .pin {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--accent-2) 18%, transparent),
      0 0 14px color-mix(in srgb, var(--accent-2) 55%, transparent);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .marker.upcoming .pin {
    background: var(--accent);
    box-shadow:
      0 0 0 4px var(--accent-soft),
      0 0 18px var(--accent);
    animation: marker-pulse 2.4s ease-in-out infinite;
  }

  @keyframes marker-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 4px var(--accent-soft),
        0 0 12px var(--accent);
    }
    50% {
      box-shadow:
        0 0 0 9px var(--accent-soft),
        0 0 24px var(--accent);
    }
  }

  .marker:hover,
  .marker:focus-visible,
  .marker.is-highlighted {
    z-index: 3;
  }

  .marker:hover .pin,
  .marker:focus-visible .pin,
  .marker[aria-pressed='true'] .pin {
    transform: scale(1.35);
  }

  .marker[aria-pressed='true'] .pin {
    background: var(--accent);
    box-shadow:
      0 0 0 5px var(--accent-soft),
      0 0 22px var(--accent);
  }

  /* Set while the matching event card is hovered or focused in the list below. */
  .marker.is-highlighted .pin {
    background: var(--accent);
    transform: scale(1.6);
    box-shadow:
      0 0 0 6px var(--accent-soft),
      0 0 26px var(--accent);
  }

  /* Expanding ring, so the eye finds the marker even on a busy cluster. */
  .marker.is-highlighted::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: marker-ping 1.4s ease-out infinite;
  }

  @keyframes marker-ping {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(3.4);
    }
  }

  /* --- Tooltip --- */

  .tip {
    position: absolute;
    bottom: calc(100% + 12px);
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    width: max-content;
    max-width: 15rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-raised);
    box-shadow: var(--shadow);
    font-size: 0.78rem;
    line-height: 1.45;
    text-align: left;
    color: var(--text-muted);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  .align-center .tip {
    left: 50%;
    transform: translate(-50%, 4px);
  }

  .align-start .tip {
    left: -6px;
    transform: translateY(4px);
  }

  .align-end .tip {
    right: -6px;
    transform: translateY(4px);
  }

  .align-center:hover .tip,
  .align-center:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .align-start:hover .tip,
  .align-start:focus-visible .tip,
  .align-end:hover .tip,
  .align-end:focus-visible .tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .tip-city {
    font-weight: 700;
    color: var(--text);
  }

  .tip-flag {
    margin-right: 0.25rem;
  }

  .tip-event {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tip-year {
    margin-left: 0.4rem;
    opacity: 0.7;
  }

  figcaption {
    margin-top: 0.7rem;
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .canvas {
      padding: 0.6rem;
      border-radius: 12px;
    }

    /* The map is a third of its desktop size here - a large hit area would
       swallow the neighbouring city. */
    .marker::before {
      inset: -6px;
    }

    .tip {
      font-size: 0.72rem;
      max-width: 11rem;
    }
  }
</style>
