---
import { focusAreas } from '../data/focus';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** Icon paths keyed by the `icon` field of a focus area. */
const icons: Record<string, string> = {
  layers: 'M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5M3 18l9 5 9-5',
  pipeline: 'M6 4v6a3 3 0 0 0 3 3h6a3 3 0 0 1 3 3v4M6 4a2 2 0 1 0-.01-.01M18 20a2 2 0 1 0-.01-.01M12 9h6',
  layout: 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5ZM3 9h18M9 9v12',
  exchange: 'M4 9h14m-4-4 4 4-4 4M20 15H6m4-4-4 4 4 4',
};
---

<ul class="focus">
  {
    focusAreas.map((area) => (
      <li class="area">
        <span class="icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d={icons[area.icon]} />
          </svg>
        </span>
        <div>
          <h3>{area.title[lang]}</h3>
          <p class="muted">{area.body[lang]}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .focus {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .area {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem 1.15rem;
    background: var(--bg-card);
    transition:
      border-color 0.2s ease,
      box-shadow 0.25s ease;
  }

  .area:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: 0 4px 24px var(--accent-glow);
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  }

  h3 {
    font-size: 0.98rem;
    margin: 0 0 0.15rem;
  }

  p {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.5;
  }

  /* Drops to one column early: below roughly 440px per card, two columns
     squeeze every body onto a third line. */
  @media (max-width: 960px) {
    .focus {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.7rem;
    }
  }
</style>
